# Ключ JS API Яндекс Карт (этап 5, H5). Получите свой на
# https://developer.tech.yandex.ru/services/ и положите значение в .env.local:
#
#   VITE_YANDEX_MAPS_KEY=ваш-ключ
#
# .env.local не коммитится (см. .gitignore). Без ключа приложение работает:
# вместо карты показывается сообщение (TASKS.md, H5).
VITE_YANDEX_MAPS_KEY=

# Демо-режим мок-авторизации КТ1 (сборка с VITE_SIX_CITIES_MOCK_AUTH=1
# показывает демопользователя вместо гостя).
VITE_SIX_CITIES_MOCK_AUTH=
